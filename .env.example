# Environment Configuration for Aabhushan AI

# App & Environment
ENVIRONMENT=development
APP_NAME=Aabhushan AI
API_URL=http://localhost:8000
WEB_URL=http://localhost:3000

# Database & Cache
DATABASE_URL=sqlite+aiosqlite:///./aabhushan.db
# For PostgreSQL 16 local docker:
# DATABASE_URL=postgresql+asyncpg://aabhushan:aabhushan_dev_password@localhost:5432/aabhushan_db
SYNC_DATABASE_URL=sqlite:///./aabhushan.db
REDIS_URL=redis://localhost:6379/0

# Storage (MinIO local or Cloudflare R2 prod)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadminpassword
S3_BUCKET=aabhushan-assets
S3_REGION=us-east-1
STORAGE_PROVIDER=local  # local or s3

# Auth & Security
JWT_SECRET=super_secret_jwt_key_for_aabhushan_dev_minimum_32_characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Gemini AI Provider
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image-preview
GEMINI_PREVIEW_MODEL=gemini-2.5-flash-image
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_MAX_CONCURRENCY=6
FIDELITY_PASS_SCORE=80
AI_PROVIDER=mock  # mock or gemini

# Razorpay Billing (Phase 2+)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

